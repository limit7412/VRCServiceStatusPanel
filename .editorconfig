root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Unityが生成・更新するJSON系アセット。Unityの書式に合わせる
[*.{asmdef,json}]
indent_style = space
indent_size = 4

# UnityがシリアライズするYAMLアセット。書式はUnityが決めるため触らない
[*.{asset,meta,prefab,unity}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2
